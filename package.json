{
    "displayName": "Homebridge Electrolux Live",
    "name": "homebridge-electrolux-live",
    "version": "0.1.0",
    "description": "Homebridge plugin for Electrolux appliances with livestream/SSE state synchronisation",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/homebridge4/homebridge-electrolux-live.git"
    },
    "bugs": {
        "url": "https://gitlab.com/homebridge4/homebridge-electrolux-live/-/issues"
    },
    "engines": {
        "node": "^22.10.0 || ^24.0.0",
        "homebridge": "^1.8.0 || ^2.0.0"
    },
    "main": "dist/index.js",
    "scripts": {
        "build": "rimraf ./dist && tsc",
        "lint": "eslint src/**.ts --max-warnings=0",
        "prepublishOnly": "npm run lint && npm run build",
        "watch": "npm run build && npm link && nodemon"
    },
    "keywords": [
        "homebridge-plugin",
        "homebridge",
        "homekit",
        "electrolux",
        "aeg",
        "livestream",
        "sse"
    ],
    "dependencies": {
        "axios": "^1.4.0",
        "lodash": "^4.17.21"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/node": "^24.19.1",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.1",
        "homebridge": "^2.4.0",
        "jiti": "^2.4.2",
        "nodemon": "^3.1.9",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.1"
    },
    "homepage": "https://gitlab.com/homebridge4/homebridge-electrolux-live",
    "author": "Tom Bromley",
    "contributors": [
        "Tomek Kleszcz - original homebridge-electrolux-devices author"
    ],
    "type": "module"
}
