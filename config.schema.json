{
    "pluginAlias": "HomebridgeElectroluxDevices",
    "pluginType": "platform",
    "singular": true,
    "schema": {
        "type": "object",
        "required": ["name", "apiKey", "refreshToken"],
        "properties": {
            "name": {
                "title": "Name",
                "type": "string",
                "default": "Electrolux"
            },
            "apiKey": {
                "title": "API key",
                "type": "string",
                "default": ""
            },
            "refreshToken": {
                "title": "Refresh token",
                "type": "string",
                "default": ""
            },
            "pollingInterval": {
                "title": "Polling interval",
                "type": "number",
                "default": 120
            },
            "carbonDioxideSensorAlarmValue": {
                "title": "Carbon dioxide sensor alarm value",
                "type": "number",
                "default": 1000
            },
            "vocMolecularWeight": {
                "title": "VOC molecular weight",
                "type": "number",
                "default": 30.026
            }
        }
    }
}
